{
  "name": "Cutout Camera",
  "short_name": "Cutouts",
  "description": "Photograph anything, get a transparent PNG of every object in it — named, with any text read off it.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d2421",
  "theme_color": "#1d2421",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "image", "accept": ["image/*"] }]
    }
  }
}
